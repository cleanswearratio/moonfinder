# Local template for `vercel dev`, which reads .env.local — copy this there and
# fill it in. In production these live in Vercel's Project Settings ->
# Environment Variables and are never committed (CLAUDE.md §9).

# Your ActiveCampaign account name, the subdomain in {ACCOUNT}.api-us1.com.
AC_ACCOUNT=
AC_API_TOKEN=
AC_LIST_ID=

# Numeric custom-field ids. Create the fields in ActiveCampaign first, then
# read their ids from `GET /api/3/fields`. §9 forbids hardcoding them in source;
# a field left blank here is simply not sent.
#
#   MOON_SIGN      text     Taurus
#   MOON_ALT_SIGN  text     Gemini   (cusp only, otherwise empty)
#   MOON_CUSP      text     yes / no
#   SUN_SIGN       text     Leo
#   BIRTH_YEAR     number   1988
#   BIRTH_TZ       text     America/New_York
#   TIME_KNOWN     text     yes / no
AC_FIELD_MOON_SIGN=
AC_FIELD_MOON_ALT_SIGN=
AC_FIELD_MOON_CUSP=
AC_FIELD_SUN_SIGN=
AC_FIELD_BIRTH_YEAR=
AC_FIELD_BIRTH_TZ=
AC_FIELD_TIME_KNOWN=
